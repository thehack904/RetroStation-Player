#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys

UNIT = "retrostation-player-startup-screen.service"
MAIN_UNIT = "retrostation-player.service"


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(2)


def run_systemctl(*arguments: str) -> None:
    completed = subprocess.run(
        ["systemctl", *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        fail((completed.stderr or completed.stdout).strip() or f"systemctl {' '.join(arguments)} failed")


def main() -> None:
    if os.geteuid() != 0:
        fail("This helper must run as root")
    argv = sys.argv[1:]
    if argv == ["enable"]:
        run_systemctl("enable", MAIN_UNIT)
        run_systemctl("enable", UNIT)
        print("enabled")
        return
    if argv == ["disable"]:
        run_systemctl("enable", MAIN_UNIT)
        run_systemctl("disable", "--now", UNIT)
        print("disabled")
        return
    if argv == ["show"]:
        # A stopped player should return to the logo only when the user has
        # enabled the feature. Starting an already-running unit is harmless.
        completed = subprocess.run(
            ["systemctl", "is-enabled", "--quiet", UNIT],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if completed.returncode == 0:
            run_systemctl("restart", UNIT)
            print("shown")
        else:
            print("disabled")
        return
    fail("Usage: helper enable|disable|show")


if __name__ == "__main__":
    main()
